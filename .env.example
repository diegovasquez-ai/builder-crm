# ============================================================================
# Para PROBAR el CRM no hace falta nada de este archivo: `npm run local` levanta
# una base embebida y abre el CRM con datos de demostracion. Lo unico que podes
# querer copiar aca es OPENROUTER_API_KEY, para que el agente conteste en el
# simulador.
#
# Este archivo es para una instancia DE VERDAD (tu Supabase, tu dominio).
# ============================================================================

# ============================================================================
# Builder CRM - variables de entorno
# ============================================================================
# Copiar a .env.local (desarrollo) o cargar en Coolify (produccion). NUNCA
# commitear .env.local. En Coolify van TODAS en runtime: desde 1.2.2 el servidor le
# entrega al navegador la configuracion publica al ejecutar, asi que no hay que marcar
# ninguna como "Build Variable". Las NEXT_PUBLIC_* viajan al navegador (no son secretas)
# y el Dockerfile tambien las acepta como build args, por si construis en una plataforma
# que las hornea. Los placeholders REEMPLAZA_ no funcionan: hay que cambiarlos.
#
# Obligatorias: DATABASE_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Todo lo demas enciende una capacidad; sin ello el CRM arranca igual y la UI avisa.

# ----------------------------------------------------------------------------
# SUPABASE (base de datos + auth) - un proyecto por cliente
# ----------------------------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://REEMPLAZA_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZA_anon_key
# Service role: SOLO servidor (crear usuarios desde Ajustes -> Equipo y scripts). Nunca al navegador.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZA_service_role_key
# Dashboard -> Connect. La app usa el pooler en modo transaccion (puerto 6543):
DATABASE_URL=postgresql://postgres.REEMPLAZA_ref:REEMPLAZA_password@aws-0-REEMPLAZA_region.pooler.supabase.com:6543/postgres
# Opcional: conexion directa (puerto 5432) para las migraciones. Si falta, se usa DATABASE_URL.
# DIRECT_URL=postgresql://postgres.REEMPLAZA_ref:REEMPLAZA_password@aws-0-REEMPLAZA_region.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------
# URL publica de la instancia (sin barra final). La usan el webhook para llamar al
# worker, los scripts y los links de las notificaciones.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# El registro publico esta abierto solo mientras no haya miembros (la primera cuenta es
# admin). "true" lo deja abierto siempre: solo para pruebas.
# ALLOW_PUBLIC_SIGNUP=false

# ----------------------------------------------------------------------------
# SECRETOS INTERNOS (generar: openssl rand -hex 32)
# ----------------------------------------------------------------------------
# Protege el worker del agente, los barridos, el simulador por script y el seed demo.
# Vacio = abierto (NO en produccion).
AGENT_WORKER_SECRET=REEMPLAZA_openssl_rand_hex_32
# Header x-webhook-secret del webhook generico de leads (/api/webhooks/leads).
LEADS_WEBHOOK_SECRET=REEMPLAZA_openssl_rand_hex_32

# ----------------------------------------------------------------------------
# AGENTE DE IA (OpenRouter: una clave, cualquier modelo)
# ----------------------------------------------------------------------------
# openrouter.ai -> Keys. Sin esto el agente y el simulador no responden.
OPENROUTER_API_KEY=REEMPLAZA_openrouter_key
# Modelo (manda sobre config.agente.modelo). Ej: google/gemini-2.5-flash,
# anthropic/claude-sonnet-4.5, openai/gpt-5-mini
AGENT_MODEL=google/gemini-2.5-flash

# ----------------------------------------------------------------------------
# ZERNIO (WhatsApp + Instagram DM + Messenger con una sola API y un solo webhook)
# ----------------------------------------------------------------------------
# zernio.com -> Settings -> API Keys
ZERNIO_API_KEY=REEMPLAZA_sk_zernio
# Perfil de Zernio (npm run zernio:setup los lista). Vacio = perfil Default.
ZERNIO_PROFILE_ID=
# Secreto que inventas y registras con `npm run zernio:webhook -- --url https://...`.
# Tiene que ser IDENTICO aqui y en la suscripcion: si no, 401 silencioso y no entran
# mensajes. Vacio = el webhook rechaza todo (fail-closed).
ZERNIO_WEBHOOK_SECRET=REEMPLAZA_openssl_rand_hex_32
# Proveedor de WhatsApp: zernio (default) | meta (valvula de escape: Cloud API directo).
WHATSAPP_PROVIDER=zernio
# ZERNIO_API_BASE=https://zernio.com/api/v1

# ----------------------------------------------------------------------------
# META CLOUD API DIRECTO (solo con WHATSAPP_PROVIDER=meta, o para BYO-WABA en Zernio)
# ----------------------------------------------------------------------------
# developers.facebook.com -> tu app -> WhatsApp -> API Setup
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# App -> Settings -> Basic -> App Secret (firma X-Hub-Signature-256 del webhook)
# WHATSAPP_APP_SECRET=
# Lo inventas y lo pones en Meta al dar de alta el webhook.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# Solo para los scripts de conexion (npm run connect:whatsapp / zernio:whatsapp):
# WHATSAPP_DISPLAY_PHONE=
# WHATSAPP_TWO_STEP_PIN=

# ----------------------------------------------------------------------------
# ENTRAR CON GOOGLE (opcional). Se configura en el servidor de autenticacion, no aqui.
# ----------------------------------------------------------------------------
# El CRM no tiene variables propias para esto: le pregunta al proveedor que tiene
# encendido y dibuja el boton solo. Autoalojado, las tres variables van en GoTrue;
# en Supabase cloud, el interruptor del panel. Paso a paso: docs/GOOGLE-AUTH.md
#
#   GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
#   GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
#   GOTRUE_EXTERNAL_GOOGLE_SECRET=...
#   GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://auth.tudominio.com/auth/v1/callback
#
# Entrar con Google NO da acceso por si solo: la persona tiene que estar en
# Ajustes -> Equipo con ese mismo correo, o cae en /sin-acceso.

# ----------------------------------------------------------------------------
# CORREOS DE ACCESO (opcional): invitaciones y "olvide mi contrasena"
# ----------------------------------------------------------------------------
# El SMTP va en el servidor de autenticacion, no aqui. Esta variable solo le dice al
# CRM que ese servidor SI manda correos, para ofrecer invitar por correo, el boton de
# reenviar acceso y el "la olvidaste?" del login.
#
# Hace falta declararlo a mano porque GoTrue sin SMTP no falla: se traga el correo y
# responde 200. Enciendelo recien cuando un correo de prueba llegue de verdad, o la UI
# va a decir "invitacion enviada" sobre algo que nunca salio.
# Paso a paso (Resend, Supabase cloud, plantillas): docs/CORREO.md
# AUTH_ENVIA_CORREOS=false
#
# Autoalojado, en el contenedor de autenticacion:
#   GOTRUE_SMTP_HOST=smtp.resend.com
#   GOTRUE_SMTP_PORT=465
#   GOTRUE_SMTP_USER=resend
#   GOTRUE_SMTP_PASS=re_...
#   GOTRUE_SMTP_ADMIN_EMAIL=crm@send.tudominio.com
#   GOTRUE_MAILER_TEMPLATES_INVITE=https://crm.tudominio.com/correo/invitacion.html
#   GOTRUE_MAILER_TEMPLATES_RECOVERY=https://crm.tudominio.com/correo/recuperacion.html

# ----------------------------------------------------------------------------
# NOTIFICACIONES PUSH (Web Push / VAPID). Generar UNA vez: npx web-push generate-vapid-keys
# ----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:REEMPLAZA_tu@email.com

# ----------------------------------------------------------------------------
# DOCUMENTOS DE LA FICHA (bucket S3-compatible: Cloudflare R2, MinIO, Supabase Storage)
# ----------------------------------------------------------------------------
# Sin estas variables la seccion Documentos avisa y el resto del CRM no se entera.
# El bucket necesita CORS para el origen del CRM: `npm run storage:setup`.
# S3_ENDPOINT=https://REEMPLAZA_account.r2.cloudflarestorage.com
# S3_BUCKET=builder-crm-documentos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ----------------------------------------------------------------------------
# OPERACION (Docker / Coolify)
# ----------------------------------------------------------------------------
# Barridos de recuperacion dentro del proceso (no aplica en Vercel). Minutos entre
# corridas; SWEEPERS_DISABLED=true los apaga.
# SWEEP_INTERVAL_MIN=30
# SWEEPERS_DISABLED=false
# El entrypoint corre las migraciones al arrancar; true las salta (replicas).
# SKIP_MIGRATIONS=false
# Commit del build, para /api/health (Coolify y compose lo pasan como build arg).
# SOURCE_COMMIT=

# ----------------------------------------------------------------------------
# MODULOS OPCIONALES (cada modulo documenta las suyas en su README)
# ----------------------------------------------------------------------------
# modules/propiedades: embeddings para busqueda semantica (sin esto, busqueda por filtros)
# OPENAI_API_KEY=
# modules/propiedades: catalogo desde Tokko Broker (npm run sync:tokko)
# TOKKO_API_KEY=
# modules/propiedades: leer links de portales inmobiliarios
# FIRECRAWL_API_KEY=

# ----------------------------------------------------------------------------
# AUTOVERIFICACION (scripts/verificar-instancia.mjs; tambien se pasan por flags)
# ----------------------------------------------------------------------------
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
